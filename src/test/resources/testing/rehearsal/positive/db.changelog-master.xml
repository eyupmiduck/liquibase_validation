<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <!-- A plain, reversible changeset used to exercise the session helper. -->
    <changeSet id="001-create-probe" author="lee.horner" dbms="postgresql">
        <sql>CREATE TABLE rehearsal_probe
             (
                 id integer
             );</sql>
        <rollback>
            <sql>DROP TABLE rehearsal_probe;</sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
